<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shortlink.shortlinkdemo.mapper.ShortLinkMapper">

    <resultMap id="BaseResultMap" type="ShortLink">
        <id column="id" property="id"/>
        <result column="short_uri" property="shortUri"/>
        <result column="origin_url" property="originUrl"/>
        <result column="create_time" property="createTime"/>
        <result column="expire_time" property="expireTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <select id="selectByShortUri" resultMap="BaseResultMap">
        SELECT id, short_uri, origin_url, create_time, expire_time, del_flag
        FROM t_short_link
        WHERE short_uri = #{shortUri}
        AND del_flag = 0
    </select>

    <insert id="insertShortLink" parameterType="ShortLink" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_short_link (short_uri, origin_url, expire_time)
        VALUES (#{shortUri}, #{originUrl}, #{expireTime})
    </insert>

</mapper>
